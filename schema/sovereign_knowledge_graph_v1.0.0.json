{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sovereign_knowledge_graph_v1.0.0",
  "type": "object",
  "description": "Sovereign Knowledge Graph schema for Khawrizm — Fitrah aligned, bias-null",
  "required": [
    "schema",
    "graph",
    "quality_audit_metrics"
  ],
  "properties": {
    "schema": {
      "type": "object"
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array"
        },
        "edges": {
          "type": "array"
        },
        "evidence": {
          "type": "array"
        },
        "schemas": {
          "type": "array"
        },
        "constraints": {
          "type": "array"
        }
      }
    },
    "quality_audit_metrics": {
      "type": "object"
    }
  },
  "sovereign_policy": {
    "bias_null": true,
    "zero_cloud": true,
    "fitrah_anchor": true
  }
}