<Window x:Class="Niyah.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Niyah Engine" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Version -->
        <TextBlock x:Name="VersionLabel" Grid.Row="0" FontSize="16" Margin="0,0,0,10"/>

        <!-- Search -->
        <GroupBox Grid.Row="1" Header="Search" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox" Grid.Column="0" Margin="0,0,10,0"/>
                    <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Click="SearchButton_Click" Width="80"/>
                </Grid>
                <ListBox x:Name="ResultsListBox" Grid.Row="1" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Add Document -->
        <GroupBox Grid.Row="2" Header="Add Document" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="DocumentTextBox" Grid.Row="0" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
                <Button x:Name="AddDocumentButton" Grid.Row="1" Content="Add Document" Click="AddDocumentButton_Click" HorizontalAlignment="Left"/>
            </Grid>
        </GroupBox>

        <!-- Status -->
        <TextBlock x:Name="StatusLabel" Grid.Row="3" FontSize="12" Foreground="Gray"/>
    </Grid>
</Window>
