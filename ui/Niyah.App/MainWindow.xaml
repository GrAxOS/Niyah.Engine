<Window x:Class="Niyah.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Niyah.Engine"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Text="Niyah.Engine" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="Search  /  URL" Margin="0,0,10,0" />
                <TextBox x:Name="QueryBox" Height="34" Width="520" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0D1116" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" Padding="10,7" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,14,14,14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Knowledge Graph" />
                <TreeView Grid.Row="1" Margin="0,14,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                    <TreeViewItem Header="Nodes" />
                    <TreeViewItem Header="Relations" />
                    <TreeViewItem Header="Evidence" />
                    <TreeViewItem Header="Sources" />
                </TreeView>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,14,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <TextBox x:Name="ConversationBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="15" />
            </Border>
            <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ComposerBox" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="15" />
                    <DockPanel Grid.Row="1" LastChildFill="False">
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="No simulated emotion. Evidence and uncertainty are explicit." />
                        <Button DockPanel.Dock="Right" Width="100" Margin="10,0,0,0" Content="Send" Click="Send_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Sources" Margin="4" Padding="12,4" Click="Tab_Click" />
            <Button Content="Evidence" Margin="4" Padding="12,4" Click="Tab_Click" />
            <Button Content="Graph" Margin="4" Padding="12,4" Click="Tab_Click" />
            <Button Content="Code" Margin="4" Padding="12,4" Click="Tab_Click" />
            <Button Content="Network" Margin="4" Padding="12,4" Click="Tab_Click" />
            <Button Content="System" Margin="4" Padding="12,4" Click="Tab_Click" />
            <Button Content="History" Margin="4" Padding="12,4" Click="Tab_Click" />
        </StackPanel>
    </Grid>
</Window>
