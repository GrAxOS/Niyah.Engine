<Application x:Class="Niyah.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#0B0D10" />
        <SolidColorBrush x:Key="PanelBrush" Color="#11151A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#252B33" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7EAF0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA3AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF" />
    </Application.Resources>
</Application>
